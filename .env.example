# Database
DATABASE_URL="postgresql://trp:trp@localhost:5432/trp?schema=public"

# API
API_PORT=3000
API_HOST=0.0.0.0
CORS_ORIGIN=http://localhost:5173,http://127.0.0.1:5173

# Security Platform foundation (V3-S04-a). Production refuses insecure bypass flags.
# SECURITY_ALLOW_INSECURE_MODE=true
# SECURITY_DISABLE_ERROR_SANITIZATION=true
# SECURITY_DISABLE_BROWSER_POLICY=true
# Public API Host values (required in production; comma-separated, no scheme or port).
# API_ALLOWED_HOSTS="api.example.com"
# API_MAX_REQUEST_BODY_BYTES=1048576
# API_REQUEST_TIMEOUT_MS=30000

# Auth (JWT) — change JWT_SECRET before any shared/deployed environment
JWT_SECRET="dev-only-change-me"
JWT_EXPIRES_IN="15m"

# Host wrapping key for Vault (SEC-07). Same class as JWT_SECRET — not a customer Vault record.
# Unset keeps Vault store/retrieve unavailable. Paper, sign-in, and research still start.
# VAULT_WRAPPING_KEY=

# Seed / development identity credentials
SEED_USER_EMAIL="admin@trp.local"
SEED_USER_PASSWORD="trp-admin-change-me"

# Host transactional mail for password recovery (optional).
# Unset MAIL_HOST keeps recovery honestly unavailable. This is host infrastructure,
# not the Notification Email channel and not a customer vault secret.
# MAIL_HOST=
# MAIL_PORT=587
# MAIL_FROM="noreply@localhost"
# MAIL_USER=
# MAIL_PASSWORD=
# PUBLIC_APP_URL="http://localhost:5173"

# Inbound API rate limiting (V3-S04-d). Platform quotas are the source of truth.
# API_PLATFORM_RATE_LIMIT=120
# API_PLATFORM_RATE_WINDOW_MS=60000
# API_SENSITIVE_RATE_LIMIT=10
# API_SENSITIVE_RATE_WINDOW_MS=60000
# Optional Nest ThrottlerGuard override (defaults match API_PLATFORM_* above).
# API_THROTTLE_TTL_MS=60000
# API_THROTTLE_LIMIT=120

# Market Data Domain — active live provider: mock | binance (default: mock)
MARKET_DATA_PROVIDER="mock"

# Market Data Cache (US008) — in-memory TTL cache between controller and provider
MARKET_CACHE_ENABLED=true
MARKET_CACHE_TICKER_TTL=5
MARKET_CACHE_CANDLES_TTL=60

# AI Gateway (optional — offline summary if unset)
OPENROUTER_API_KEY=""
OPENROUTER_MODEL="openai/gpt-4o-mini"
OPENROUTER_BASE_URL="https://openrouter.ai/api/v1"

# Web (Vite)
# Browser policy permits this API origin for cookie-authenticated requests.
# Production must use the public HTTPS API origin; development allows Vite live reload only.
VITE_API_URL=http://localhost:3000
