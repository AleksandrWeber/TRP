  createdAt        DateTime @map("created_at")
  schemaVersion    Int      @default(1) @map("schema_version")

  @@index([workspaceId, sessionId])
  @@index([sessionId, status])
  @@map("session_recovery_incidents")
}

/// RC-16 M2 US159-US161 durable paper Order aggregate.
model PaperOrder {
  id               String                @id
  workspaceId      String                @map("workspace_id")
  /// RC-27 Epic 4 — Exchange Scope identity (default Binance).
  exchangeScopeId  String                @default("exchange-scope:binance") @map("exchange_scope_id")
  paperAccountId   String                @map("paper_account_id")
  tradingSessionId String                @map("trading_session_id")
  clientOrderId    String                @map("client_order_id")
  intentHash       String                @map("intent_hash")
  idempotencyKey   String                @map("idempotency_key")
  instrument       String
  side             String
  type             String
  quantity         Decimal               @db.Decimal(38, 18)
  limitPrice       Decimal?              @map("limit_price") @db.Decimal(38, 18)
  filledQuantity   Decimal               @default(0) @map("filled_quantity") @db.Decimal(38, 18)
  status           String
  version          Int                   @default(1)
  intent           Json
  riskDecisionId   String?               @map("risk_decision_id")
  riskDecision     Json?                 @map("risk_decision")
  reservationId    String?               @map("reservation_id")
  adapterOrderId   String?               @map("adapter_order_id")
  rejectionReason  String?               @map("rejection_reason")
  createdAt        DateTime              @map("created_at")
  recordedAt       DateTime              @map("recorded_at")
