generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  ADMINISTRATOR
  RESEARCHER
  TRADER
  VIEWER
}

model User {
  id           String   @id @default(cuid())
  email        String   @unique
  passwordHash String?
  displayName  String   @default("")
  status       String   @default("Active")
  role         Role     @default(RESEARCHER)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

/// Auth-owned login lockout (V3-S01-b). Not Identity profile. Not a session store.
model AuthLoginLockout {
  userId         String    @id @map("user_id")
  failedAttempts Int       @default(0) @map("failed_attempts")
  lockedUntil    DateTime? @map("locked_until")
  updatedAt      DateTime  @updatedAt @map("updated_at")

  @@map("auth_login_lockouts")
}

/// Auth-owned operator session (V3-S01-c). Not Trading Session / SessionRecoveryState.
model AuthSession {
  id               String    @id
  familyId         String    @map("family_id")
  userId           String    @map("user_id")
  refreshTokenHash String    @unique @map("refresh_token_hash")
  expiresAt        DateTime  @map("expires_at")
  revokedAt        DateTime? @map("revoked_at")
  replacedById     String?   @map("replaced_by_id")
  ip               String?
  userAgent        String?   @map("user_agent")
  mfaSatisfied     Boolean   @default(false) @map("mfa_satisfied")
  createdAt        DateTime  @map("created_at")

  @@index([userId])
  @@index([familyId])
  @@map("auth_sessions")
}

/// Auth-owned password reset token (V3-S01-e). Not Identity. Not Notification Delivery.
model AuthPasswordReset {
  id         String    @id
  userId     String    @map("user_id")
  tokenHash  String    @unique @map("token_hash")
  expiresAt  DateTime  @map("expires_at")
  consumedAt DateTime? @map("consumed_at")
  createdAt  DateTime  @map("created_at")

  @@index([userId])
  @@map("auth_password_resets")
}

/// Vault-owned customer vendor secret ciphertext (V3-S03-b).
/// Not ExchangeConnection. Not host wrapping key. No plaintext columns.
model VaultSecret {
  id             String    @id
  workspaceId    String    @map("workspace_id")
  type           String
  purpose        String
  state          String
  revision       Int       @default(0)
  wrappingSalt   String?   @map("wrapping_salt")
  wrappedDataKey String?   @map("wrapped_data_key")
  dataKeyNonce   String?   @map("data_key_nonce")
  dataKeyTag     String?   @map("data_key_tag")
  payload        String?
  payloadNonce   String?   @map("payload_nonce")
  payloadTag     String?   @map("payload_tag")
  createdAt      DateTime  @map("created_at")
  updatedAt      DateTime  @map("updated_at")

  @@unique([workspaceId, type, purpose])
  @@index([workspaceId])
  @@map("vault_secrets")
}

/// Security Audit-owned immutable history (V3-S05-a).
/// This is not Authentication, RBAC, Vault, Monitoring, or Ledger state.
model SecurityAuditRecord {
  id                 String   @id
  eventType          String   @map("event_type")
  eventClass         String   @map("event_class")
  criticality        String
  schemaVersion      Int      @map("schema_version")
  workspaceId        String?  @map("workspace_id")
  actorId            String?  @map("actor_id")
  subjectId          String?  @map("subject_id")
  resourceType       String?  @map("resource_type")
  resourceId         String?  @map("resource_id")
  outcome            String
  occurredAt         DateTime @map("occurred_at")
  recordedAt         DateTime @map("recorded_at")
  correlationId      String?  @map("correlation_id")
  source             String
  eventFingerprint   String   @map("event_fingerprint")
  payload            Json
  integrityVersion   Int      @map("integrity_version")
  integrityHash      String   @map("integrity_hash")
  incidentLinks      SecurityAuditIncidentEvent[]

  @@index([workspaceId, occurredAt])
  @@index([eventType, occurredAt])
  @@index([eventClass, occurredAt])
  @@index([actorId, occurredAt])
  @@map("security_audit_records")
}

/// Security Audit investigation container (V3-S05-d). Evidence remains on audit events.
model SecurityAuditIncident {
  id               String                              @id
  workspaceId      String                              @map("workspace_id")
  openedAt         DateTime                            @map("opened_at")
  openedByActorId  String?                             @map("opened_by_actor_id")
  events           SecurityAuditIncidentEvent[]
  lifecycle        SecurityAuditIncidentLifecycleEntry[]

  @@index([workspaceId, openedAt])
  @@map("security_audit_incidents")
}

/// Append-only reference: Incident contains Event, without copying event facts.
model SecurityAuditIncidentEvent {
  incidentId String               @map("incident_id")
  eventId    String               @map("event_id")
  linkedAt   DateTime             @map("linked_at")
  incident   SecurityAuditIncident @relation(fields: [incidentId], references: [id], onDelete: Restrict)
  event      SecurityAuditRecord   @relation(fields: [eventId], references: [id], onDelete: Restrict)

  @@id([incidentId, eventId])
  @@index([eventId])
  @@map("security_audit_incident_events")
}

/// Append-only lifecycle facts; current incident state is derived from the latest entry.
model SecurityAuditIncidentLifecycleEntry {
  incidentId String                @map("incident_id")
  occurredAt DateTime              @map("occurred_at")
  status     String
  actorId    String?               @map("actor_id")
  incident   SecurityAuditIncident @relation(fields: [incidentId], references: [id], onDelete: Restrict)

  @@id([incidentId, occurredAt])
  @@map("security_audit_incident_lifecycle")
}


/// Durable Workspace aggregate and ownership boundary (RC-16 Foundations / US002).
model WorkspaceRecord {
  id          String   @id
  name        String
  ownerUserId String   @map("owner_user_id")
  status      String
  createdAt   DateTime @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  @@index([ownerUserId, status])
  @@map("workspace_records")
}

/// Connection Management-owned workspace metadata (W2-S01-a/b).
/// Credentials and ciphertext remain Vault-owned; this nullable value is an opaque Vault id only.
model ConnectionRecord {
  id             String   @id
  workspaceId    String   @map("workspace_id")
  displayName    String   @map("display_name")
  provider       String
  connectionType String   @map("connection_type")
  vaultSecretId  String?  @map("vault_secret_id")
  status         String   @default("DISCONNECTED")
  createdAt      DateTime @map("created_at")
  updatedAt      DateTime @updatedAt @map("updated_at")

  @@index([workspaceId, createdAt])
  @@index([workspaceId, provider])
  @@unique([workspaceId, provider, vaultSecretId])
  @@map("connection_records")
}

/// Workspace AI Session — metadata-only execution context (W2-S05-c).
/// Groups independent AI request identities for operators.
/// Does not store prompts, responses, conversation, or memory.
/// Does not influence AI Gateway / OpenRouter request content.
model WorkspaceAiSession {
  id          String    @id
  workspaceId String    @map("workspace_id")
  displayName String    @map("display_name")
  status      String
  createdBy   String    @map("created_by")
  createdAt   DateTime  @map("created_at")
  closedAt    DateTime? @map("closed_at")
  updatedAt   DateTime  @updatedAt @map("updated_at")

  memberships WorkspaceAiSessionRequest[]

  @@index([workspaceId, status, createdAt])
  @@map("workspace_ai_sessions")
}

/// Session request membership — identity and status only (W2-S05-c).
/// Never stores prompt text or model response content.
model WorkspaceAiSessionRequest {
  id           String   @id
  sessionId    String   @map("session_id")
  workspaceId  String   @map("workspace_id")
  connectionId String   @map("connection_id")
  requestId    String   @map("request_id")
  status       String
  requestedAt  DateTime @map("requested_at")
  createdAt    DateTime @default(now()) @map("created_at")

  session WorkspaceAiSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)

  @@unique([workspaceId, requestId])
  @@index([sessionId, requestedAt])
  @@index([workspaceId, sessionId])
  @@map("workspace_ai_session_requests")
}

/// Workspace AI Request History — read-only operational record (W2-S05-d).
/// Audit-style metadata only. Does not store prompts or responses.
/// Does not reconstruct conversation, memory, or context for AI.
/// History never influences future AI requests.
model WorkspaceAiRequestHistory {
  id                 String   @id
  workspaceId        String   @map("workspace_id")
  sessionId          String   @map("session_id")
  requestId          String   @map("request_id")
  connectionId       String   @map("connection_id")
  executedAt         DateTime @map("executed_at")
  status             String
  model              String?
  durationMs         Int      @map("duration_ms")
  createdAt          DateTime @default(now()) @map("created_at")

  @@unique([workspaceId, requestId])
  @@index([workspaceId, executedAt])
  @@index([workspaceId, sessionId, executedAt])
  @@index([workspaceId, status, executedAt])
  @@map("workspace_ai_request_history")
}

/// Workspace-owned Strategy definition (US004) with trading configuration (US005).
model StrategyRecord {
  id                String   @id
  workspaceId       String   @map("workspace_id")
  name              String
  description       String
  status            String
  tradingPair       String   @map("trading_pair")
  timeframe         String
  direction         String
  positionSize      Float    @map("position_size")
  stopLossPercent   Float    @map("stop_loss_percent")
  takeProfitPercent Float    @map("take_profit_percent")
  parameters        Json
  createdAt         DateTime @map("created_at")
  updatedAt         DateTime @updatedAt @map("updated_at")

  @@index([workspaceId, status])
  @@index([workspaceId, createdAt])
  @@index([workspaceId, tradingPair, timeframe])
  @@map("strategy_records")
}

model Dataset {
  id                String                     @id @default(cuid())
  displayName       String                     @default("")
  description       String                     @default("")
  marketRegime      String                     @default("UNCLASSIFIED")
  symbol            String
  symbols           String[]                   @default([])
  timeframe         String
  exchange          String                     @default("binance")
  enabled           Boolean                    @default(true)
  contentHash       String                     @unique
  barCount          Int
  startTime         DateTime
  endTime           DateTime
  gitCommit         String?
  createdAt         DateTime                   @default(now())
  bars              OhlcvBar[]
  experiments       Experiment[]
  historicalResults HistoricalResearchResult[]

  @@index([symbol, timeframe])
  @@index([enabled, marketRegime])
}

model OhlcvBar {
  id        String   @id @default(cuid())
  datasetId String
  timestamp DateTime
  open      Float
  high      Float
  low       Float
  close     Float
  volume    Float
  dataset   Dataset  @relation(fields: [datasetId], references: [id], onDelete: Cascade)

  @@unique([datasetId, timestamp])
  @@index([datasetId, timestamp])
}

model Experiment {
  id              String              @id @default(cuid())
  datasetId       String
  strategyId      String
  strategyVersion String
  configHash      String
  gitCommit       String?
  verdict         String
  report          Json
  metrics         Json
  validation      Json
  trades          Json
  createdAt       DateTime            @default(now())
  dataset         Dataset             @relation(fields: [datasetId], references: [id])
  deployment      StrategyDeployment?
  knowledge       KnowledgeEntry[]

  @@index([datasetId])
  @@index([createdAt])
  @@index([verdict])
}

/// One immutable Historical Research invocation (US018).
/// Every invocation receives a new id; completed results are never overwritten.
model HistoricalResearchRun {
  id          String                     @id
  workspaceId String                     @map("workspace_id")
  status      String
  datasetIds  Json                       @map("dataset_ids")
  strategyIds Json                       @map("strategy_ids")
  report      Json?
  failure     String?
  startedAt   DateTime                   @map("started_at")
  completedAt DateTime?                  @map("completed_at")
  results     HistoricalResearchResult[]

  @@index([workspaceId, startedAt])
  @@index([workspaceId, status])
  @@map("historical_research_runs")
}

/// Immutable Strategy × Dataset × Market Regime result (US018).
/// Scalar metrics are queryable for a future regime-performance matrix.
model HistoricalResearchResult {
  id                 String                @id
  researchId         String                @map("research_id")
  workspaceId        String                @map("workspace_id")
  datasetId          String                @map("dataset_id")
  datasetName        String                @map("dataset_name")
  datasetContentHash String                @map("dataset_content_hash")
  marketRegime       String                @map("market_regime")
  strategyId         String                @map("strategy_id")
  strategyName       String                @map("strategy_name")
  strategySnapshot   Json                  @map("strategy_snapshot")
  exchange           String
  symbol             String
  timeframe          String
  status             String
  failure            String?
  trades             Json
  tradeCount         Int                   @map("trade_count")
  winRate            Float                 @map("win_rate")
  netProfit          Float                 @map("net_profit")
  profitFactor       Float                 @map("profit_factor")
  maxDrawdown        Float                 @map("max_drawdown")
  executionTimeMs    Int                   @map("execution_time_ms")
  validation         Json
  resultHash         String                @map("result_hash")
  createdAt          DateTime              @map("created_at")
  research           HistoricalResearchRun @relation(fields: [researchId], references: [id], onDelete: Restrict)
  dataset            Dataset               @relation(fields: [datasetId], references: [id], onDelete: Restrict)

  @@unique([researchId, datasetId, strategyId, symbol])
  @@index([workspaceId, strategyId, marketRegime])
  @@index([workspaceId, datasetId])
  @@index([workspaceId, createdAt])
  @@map("historical_research_results")
}

model StrategyDeployment {
  id              String              @id @default(cuid())
  experimentId    String              @unique
  strategyId      String
  strategyVersion String
  symbol          String
  timeframe       String
  exchange        String              @default("binance")
  mode            String              @default("paper")
  status          String              @default("active")
  approvedAt      DateTime            @default(now())
  gitCommit       String?
  experiment      Experiment          @relation(fields: [experimentId], references: [id])
  position        ProductionPosition?
  signals         Signal[]
  executions      Execution[]

  @@index([status])
  @@index([symbol, timeframe])
}

model ProductionPosition {
  id           String             @id @default(cuid())
  deploymentId String             @unique
  side         String             @default("flat")
  quantity     Float              @default(0)
  entryPrice   Float?
  updatedAt    DateTime           @updatedAt
  deployment   StrategyDeployment @relation(fields: [deploymentId], references: [id], onDelete: Cascade)
}

model Signal {
  id           String             @id @default(cuid())
  deploymentId String
  type         String
  price        Float
  timestamp    DateTime
  actedOn      Boolean            @default(false)
  createdAt    DateTime           @default(now())
  deployment   StrategyDeployment @relation(fields: [deploymentId], references: [id], onDelete: Cascade)
  execution    Execution?

  @@index([deploymentId, createdAt])
}

model Execution {
  id           String             @id @default(cuid())
  deploymentId String
  signalId     String             @unique
  symbol       String
  side         String
  quantity     Float
  price        Float
  fee          Float
  mode         String             @default("paper")
  status       String
  rejectReason String?
  executedAt   DateTime           @default(now())
  deployment   StrategyDeployment @relation(fields: [deploymentId], references: [id], onDelete: Cascade)
  signal       Signal             @relation(fields: [signalId], references: [id])

  @@index([deploymentId, executedAt])
}

model Workflow {
  id          String           @id @default(cuid())
  type        String
  status      String           @default("pending")
  context     Json
  error       String?
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt
  completedAt DateTime?
  steps       WorkflowStep[]
  knowledge   KnowledgeEntry[]

  @@index([status])
  @@index([createdAt])
}

model WorkflowStep {
  id          String    @id @default(cuid())
  workflowId  String
  name        String
  stepOrder   Int
  status      String    @default("pending")
  result      Json?
  error       String?
  startedAt   DateTime?
  completedAt DateTime?
  workflow    Workflow  @relation(fields: [workflowId], references: [id], onDelete: Cascade)

  @@index([workflowId, stepOrder])
}

model KnowledgeEntry {
  id               String      @id @default(cuid())
  type             String
  title            String
  description      String
  category         String
  tags             String[]
  version          Int         @default(1)
  parentId         String?
  validationStatus String
  workflowId       String?
  experimentId     String?
  authorEmail      String?
  payload          Json
  createdAt        DateTime    @default(now())
  updatedAt        DateTime    @updatedAt
  workflow         Workflow?   @relation(fields: [workflowId], references: [id])
  experiment       Experiment? @relation(fields: [experimentId], references: [id])

  @@index([type])
  @@index([category])
  @@index([createdAt])
}

model DomainEventLog {
  id            String   @id @default(cuid())
  type          String
  correlationId String?
  payload       Json
  createdAt     DateTime @default(now())

  @@index([type, createdAt])
}

model AiRequestLog {
  id         String   @id @default(cuid())
  task       String
  provider   String
  model      String
  success    Boolean
  durationMs Int
  error      String?
  createdAt  DateTime @default(now())

  @@index([createdAt])
}

/// Research OS domain persistence (US104) — JSON payload mirrors domain aggregates.
/// Distinct from legacy KnowledgeEntry (research_outcome / workflow knowledge).

model ResearchCampaignRecord {
  id      String @id
  payload Json

  @@map("research_campaign_records")
}

model ResearchDomainKnowledge {
  knowledgeId  String @id @map("knowledge_id")
  experimentId String @unique @map("experiment_id")
  payload      Json

  @@map("research_domain_knowledge")
}

model ResearchInsight {
  id      String @id
  payload Json

  @@map("research_insights")
}

model ResearchRecommendation {
  id      String @id
  payload Json

  @@map("research_recommendations")
}

model ResearchReportAggregate {
  id      String @id
  payload Json

  @@map("research_report_aggregates")
}

/// RC-16 ADR-013 durable Outbox (US128). Envelope immutable; delivery metadata mutable.
enum OutboxDeliveryStatus {
  pending
  publishing
  published
  dead_letter
}

model OutboxEvent {
  eventId          String               @id @map("event_id")
  eventType        String               @map("event_type")
  schemaVersion    Int                  @map("schema_version")
  aggregateType    String               @map("aggregate_type")
  aggregateId      String               @map("aggregate_id")
  aggregateVersion Int                  @map("aggregate_version")
  workspaceId      String               @map("workspace_id")
  occurredAt       DateTime             @map("occurred_at")
  recordedAt       DateTime             @map("recorded_at")
  correlationId    String?              @map("correlation_id")
  causationId      String?              @map("causation_id")
  actorId          String?              @map("actor_id")
  payload          Json
  status           OutboxDeliveryStatus @default(pending)
  attempts         Int                  @default(0)
  lastError        String?              @map("last_error")
  nextAttemptAt    DateTime?            @map("next_attempt_at")
  publishedAt      DateTime?            @map("published_at")
  createdAt        DateTime             @default(now()) @map("created_at")
  updatedAt        DateTime             @updatedAt @map("updated_at")
  consumerDeliveries OutboxConsumerDelivery[]

  @@unique([aggregateType, aggregateId, aggregateVersion])
  @@index([workspaceId, status, createdAt])
  @@index([status, nextAttemptAt, createdAt])
  @@map("outbox_events")
}

/// Durable per-consumer Outbox delivery acknowledgement (TD-042 / ADR-013).
/// Independent of the single Outbox publication status so fan-out can resume
/// after restart without re-invoking already-acknowledged consumers.
model OutboxConsumerDelivery {
  eventId     String   @map("event_id")
  consumerId  String   @map("consumer_id")
  deliveredAt DateTime @map("delivered_at")
  event       OutboxEvent @relation(fields: [eventId], references: [eventId], onDelete: Cascade, onUpdate: Cascade)

  @@id([eventId, consumerId])
  @@index([consumerId, deliveredAt])
  @@map("outbox_consumer_deliveries")
}

/// RC-16 ADR-013 consumer Inbox (US129). Unique (consumerId, eventId).
model InboxRecord {
  consumerId      String   @map("consumer_id")
  eventId         String   @map("event_id")
  consumerVersion String   @map("consumer_version")
  processedAt     DateTime @map("processed_at")

  @@id([consumerId, eventId])
  @@index([eventId])
  @@map("inbox_records")
}

enum ConsumerCheckpointDeliveryStatus {
  ready
  blocked_gap
  error
}

/// RC-16 US141 durable market stream checkpoints (ADR-013/014, ADR-018 #25).
/// Semantic progress (sequence/event/occurredAt) is distinct from operational
/// heartbeat time. Future Trading Sessions read, never write, these rows.
model MarketStreamCheckpointRecord {
  workspaceId    String    @map("workspace_id")
  streamId       String    @map("stream_id")
  sourceId       String    @map("source_id")
  instrument     String
  channel        String
  timeframe      String?
  schemaVersion  Int       @default(1) @map("schema_version")
  lastSequence   Int       @map("last_sequence")
  lastEventId    String?   @map("last_event_id")
  lastOccurredAt DateTime? @map("last_occurred_at")
  health         String
  /// Operational liveness only — never semantic progress.
  heartbeatAt    DateTime? @map("heartbeat_at")
  updatedAt      DateTime  @map("updated_at")

  @@id([workspaceId, streamId])
  @@index([workspaceId, sourceId])
  @@map("market_stream_checkpoints")
}

/// RC-16 US142 durable desired subscriptions (ADR-014).
/// Desired state survives process restart — not connector socket memory.
model MarketSubscriptionRecord {
  id          String   @id
  workspaceId String   @map("workspace_id")
  sourceId    String   @map("source_id")
  instrument  String
  channel     String
  streamId    String   @map("stream_id")
  timeframe   String?
  state       String
  updatedAt   DateTime @map("updated_at")

  @@unique([workspaceId, streamId])
  @@index([workspaceId, sourceId, state])
  @@map("market_subscriptions")
}

/// RC-16 ADR-013 consumer checkpoints (US129).
model ConsumerCheckpointRecord {
  consumerId          String                           @map("consumer_id")
  streamId            String                           @map("stream_id")
  consumerVersion     String                           @map("consumer_version")
  workspaceId         String                           @map("workspace_id")
  lastAppliedSequence Int                              @map("last_applied_sequence")
  lastAppliedEventId  String?                          @map("last_applied_event_id")
  status              ConsumerCheckpointDeliveryStatus @default(ready)
  blockedSequence     Int?                             @map("blocked_sequence")
  lastError           String?                          @map("last_error")
  updatedAt           DateTime                         @updatedAt @map("updated_at")

  @@id([consumerId, streamId])
  @@index([workspaceId, consumerId])
  @@map("consumer_checkpoints")
}

/// RC-16 M3 US215 versioned Strategy Runtime checkpoint.
/// Resume progress only — no Orders/Risk/Execution/Fill/Position/Session lease state.
model StrategyCheckpoint {
  id                   String   @id
  workspaceId          String   @map("workspace_id")
  deploymentId         String   @map("deployment_id")
  sessionId            String   @map("session_id")
  lastProcessedCandle  Json     @map("last_processed_candle")
  lastProcessedEventId String   @map("last_processed_event_id")
  runtimeVersion       String   @map("runtime_version")
  version              Int      @default(1)
  updatedAt            DateTime @map("updated_at")

  @@unique([workspaceId, sessionId])
  @@index([workspaceId, deploymentId])
  @@map("strategy_checkpoints")
}

/// RC-16 M3 US214 immutable Signal Intent (Strategy Runtime output).
/// Append-only command fact. Not an Order. Unique semantic identity dedupes retries.
model SignalIntent {
  id               String   @id
  intentVersion    Int      @map("intent_version")
  intentHash       String   @map("intent_hash")
  workspaceId      String   @map("workspace_id")
  /// RC-27 Epic 4 — Exchange Scope identity (default Binance).
  exchangeScopeId  String   @default("exchange-scope:binance") @map("exchange_scope_id")
  deploymentId     String   @map("deployment_id")
  sessionId        String   @map("session_id")
  strategyVersion  String   @map("strategy_version")
  instrument       String
  timeframe        String
  direction        String
  confidence       Float?
  marketCheckpoint Json     @map("market_checkpoint")
  generatedAt      DateTime @map("generated_at")
  recordedAt       DateTime @map("recorded_at")
  actorId          String   @map("actor_id")
  correlationId    String?  @map("correlation_id")
  metadata         Json

  @@unique([workspaceId, intentHash])
  @@index([workspaceId, sessionId, generatedAt])
  @@index([workspaceId, deploymentId])
  @@map("signal_intents")
}

/// RC-16 M3 US211 immutable Strategy Deployment configuration.
/// Prisma model name avoids collision with Stage-1 read-only StrategyDeployment.
/// Owns approved strategy identity/config only — no Trading Session runtime.
model PaperStrategyDeployment {
  id                            String    @id
  workspaceId                   String    @map("workspace_id")
  /// RC-27 Epic 4 — Exchange Scope identity (default Binance).
  exchangeScopeId               String    @default("exchange-scope:binance") @map("exchange_scope_id")
  strategyId                    String    @map("strategy_id")
  strategyVersion               String    @map("strategy_version")
  experimentId                  String?   @map("experiment_id")
  parameters                    Json
  instrument                    String
